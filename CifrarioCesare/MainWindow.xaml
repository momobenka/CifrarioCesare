<Window x:Class="CifrarioCesare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cifrario di Cesare"
        Height="520"
        Width="850"
        MinHeight="480"
        MinWidth="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cifrario di Cesare"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CRITTOGRAFIA -->
            <GroupBox Header="Crittografia"
                      Grid.Column="0"
                      Padding="12">

                <StackPanel>
                    <TextBlock Text="Inserisci la chiave:"/>

                    <TextBox x:Name="txtChiaveCifra"
                             Margin="0,5,0,15"
                             Height="30"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="Inserisci il messaggio:"/>

                    <TextBox x:Name="txtMessaggio"
                             Margin="0,5,0,15"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Content="Crittografa"
                            Height="35"
                            Click="BtnCrittografa_Click"/>

                    <TextBlock Text="Messaggio crittografato:"
                               Margin="0,20,0,5"/>

                    <TextBox x:Name="txtRisultatoCifra"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </GroupBox>

            <!-- DECRITTOGRAFIA -->
            <GroupBox Header="Decrittografia"
                      Grid.Column="2"
                      Padding="12">

                <StackPanel>
                    <TextBlock Text="Inserisci il messaggio crittografato:"/>

                    <TextBox x:Name="txtMessaggioCifrato"
                             Margin="0,5,0,15"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Inserisci la chiave:"/>

                    <TextBox x:Name="txtChiaveDecifra"
                             Margin="0,5,0,15"
                             Height="30"
                             VerticalContentAlignment="Center"/>

                    <Button Content="Decrittografa"
                            Height="35"
                            Click="BtnDecrittografa_Click"/>

                    <TextBlock Text="Messaggio decrittografato:"
                               Margin="0,20,0,5"/>

                    <TextBox x:Name="txtRisultatoDecifra"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>